# Superset env (adapted from apache/superset 3.0.0 docker/.env).
# Copy to docker/.env and set SUPERSET_SECRET_KEY.

# Superset metadata DB (lives in the project's existing Postgres service "db")
DATABASE_DIALECT=postgresql+psycopg2
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=superset
DATABASE_PASSWORD=superset
DATABASE_DB=superset_db

# Examples DB (examples are not loaded, but superset_config.py builds the URI)
EXAMPLES_HOST=db
EXAMPLES_PORT=5432
EXAMPLES_USER=examples
EXAMPLES_PASSWORD=examples
EXAMPLES_DB=examples_db

# /app/pythonpath holds the mounted superset_config.py
PYTHONPATH=/app/pythonpath:/app/docker/pythonpath_dev
REDIS_HOST=redis
REDIS_PORT=6379

# Generate with: openssl rand -base64 42
SUPERSET_SECRET_KEY=change_me_generate_with_openssl_rand_base64_42

FLASK_DEBUG=false
SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=no
CYPRESS_CONFIG=false
SUPERSET_PORT=8088
MAPBOX_API_KEY=''
