# Superset settings (based on apache/superset 6.1.0 docker/.env). Create
# docker/.env with `make init`. The metadata DB password and the weather DB
# connection come from the root .env via docker-compose.

# Superset metadata DB (database superset_db in the project's Postgres)
DATABASE_DIALECT=postgresql+psycopg2
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=superset
DATABASE_DB=superset_db

# /app/pythonpath holds the mounted superset_config.py
PYTHONPATH=/app/pythonpath:/app/docker/pythonpath_dev
REDIS_HOST=redis
REDIS_PORT=6379

# Signs sessions and encrypts stored DB passwords. Never change it after first start
SUPERSET_SECRET_KEY=change_me
# Password of the Superset "admin" user, applied when the admin is first created
ADMIN_PASSWORD=change_me

FLASK_DEBUG=false
SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=no
CYPRESS_CONFIG=false
SUPERSET_PORT=8088
MAPBOX_API_KEY=''
