# Template for .env. Create .env with `make init` (scripts/init_env.sh): it fills
# every `change_me` with a random secret and every `auto` with a value for this
# machine. Never commit .env.

# --- Postgres -----------------------------------------------------------------
# Cluster superuser: administration only, no application connects with it
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me
# Host port for psql/DBeaver (bound to 127.0.0.1). 5000 clashes with AirPlay on macOS
POSTGRES_HOST_PORT=5434
# App role: owns the weather database and schema dev (ingest + dbt). Not a superuser
DB_USER=db_user
DB_PASSWORD=change_me
DB_NAME=db
DB_HOST=db
DB_PORT=5432
# weather_reader: SELECT-only role for Superset charts and the dbt/Postgres MCP servers
DB_READER_PASSWORD=change_me
# Metadata databases of Airflow (airflow_db) and Superset (superset_db)
AIRFLOW_DB_PASSWORD=change_me
SUPERSET_DB_PASSWORD=change_me

# Failure alerts: Slack/Discord incoming-webhook URL (empty = only logged)
ALERT_WEBHOOK_URL=

# Backups (db_backup service): daily at BACKUP_HOUR_UTC, kept BACKUP_KEEP_DAYS days in ./backups
BACKUP_HOUR_UTC=2
BACKUP_KEEP_DAYS=7

# --- Weatherstack API (https://weatherstack.com) --------------------------------
WEATHERSTACK_API_KEY=your_weatherstack_api_key
WEATHER_CITY=New York
# true = built-in sample response (no API calls); false = call the real API
USE_MOCK_API=true

# --- Airflow --------------------------------------------------------------------
# Signs Airflow's API tokens; fixed so tokens survive container re-creation
AIRFLOW_JWT_SECRET=change_me
# One dbt image for the compose dbt service, the DAG's DockerOperator and dbt-mcp
DBT_IMAGE=ghcr.io/dbt-labs/dbt-postgres:1.9.0
# Absolute HOST path of ./dbt for the DockerOperator. Leave empty: airflow/start.sh
# detects it from the Airflow container's own mounts
DBT_HOST_PATH=
# Network the DockerOperator attaches dbt containers to (compose creates it)
DOCKER_NETWORK=weather_network
# Group id of /var/run/docker.sock (Airflow starts dbt containers through it)
DOCKER_GID=auto
# User/group the dbt and backup containers run as (writes ./backups)
HOST_UID=auto
HOST_GID=auto

# --- Superset -------------------------------------------------------------------
# Signs sessions and encrypts stored DB passwords. Never change it after first start
SUPERSET_SECRET_KEY=change_me
# Password of the Superset "admin" user, applied when the admin is first created
SUPERSET_ADMIN_PASSWORD=change_me
# Public address; on a server behind HTTPS use e.g. https://superset.example.com
SUPERSET_PUBLIC_URL=http://localhost:8089

# --- MCP servers (AI clients) ----------------------------------------------------
# Airflow user "mcp" that airflow_mcp logs in as. viewer + --safe = read-only;
# op + --unsafe also allows triggering/pausing DAGs
AIRFLOW_MCP_PASSWORD=change_me
AIRFLOW_MCP_ROLE=viewer
AIRFLOW_MCP_MODE=--safe
# dbt MCP: safe = inspect/lineage/query/test as weather_reader; full = also
# build/run/seed, which needs DBT_MCP_DB_USER/DBT_MCP_DB_PASSWORD = DB_USER/DB_PASSWORD
DBT_MCP_MODE=safe
# DBT_MCP_DB_USER=
# DBT_MCP_DB_PASSWORD=
