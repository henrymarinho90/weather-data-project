# Postgres credentials (used by db, ingest script and dbt)
DB_USER=db_user
DB_PASSWORD=change_me
DB_NAME=db
DB_HOST=db
DB_PORT=5432

# Weatherstack API (https://weatherstack.com)
WEATHERSTACK_API_KEY=your_weatherstack_api_key
WEATHER_CITY=New York
# true = use mock data (free tier quota is tiny); false = call the real API
USE_MOCK_API=true

# Absolute HOST path to this repo's dbt folder (DockerOperator mounts it via the host docker daemon)
DBT_HOST_PATH=/absolute/path/to/weather-data-project/dbt

# Group id of docker socket: stat -c %g /var/run/docker.sock
DOCKER_GID=1001
AIRFLOW_UID=1000

# Airflow MCP server (airflow_mcp service): password for the Airflow "mcp" user
# it logs in as. Generate one with: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
AIRFLOW_MCP_PASSWORD=change_me
# viewer + --safe = read-only. For write tools (trigger/pause DAGs) use op + --unsafe
AIRFLOW_MCP_ROLE=viewer
AIRFLOW_MCP_MODE=--safe
